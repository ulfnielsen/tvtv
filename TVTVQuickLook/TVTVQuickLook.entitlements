<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Quick Look preview extensions must be sandboxed: without
	  com.apple.security.app-sandbox, PlugInKit silently declines to register
	  the extension at all (`pluginkit -m -i com.tvtv.app.quicklook` returns no
	  record, not even a disabled one) and Finder previews never appear.

	  The host app, TVTV.app, is deliberately NOT sandboxed — it opens
	  multi-GB files the user picks and writes edits back over them. Only this
	  extension is, which is the same split the sibling TVMV app uses.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Quick Look hands the extension a file the user selected in Finder. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>

	<!--
	  Deliberately NO com.apple.security.temporary-exception.files.
	  absolute-path.read-only. Quick Look issues a kernel-level sandbox
	  extension token for the specific file it previews, so DuckDB and the
	  Vortex FFI can open that path directly even though they use POSIX open()
	  rather than the URL they were handed. Measured on .parquet and .vtx, with
	  the blanket "/" read exception and without it: the extension spawns and
	  logs zero sandbox denials either way, so the exception granted read access
	  to every file the user can read and bought nothing. The preview parses
	  untrusted data files through
	  DuckDB and a Rust FFI, which is precisely the surface the sandbox is meant
	  to contain — so it stays narrow.
	-->
</dict>
</plist>
